PORT=3000
# Base de trabajo en PostgreSQL local (sin Docker). Sustituye la contraseña de ejemplo por la tuya:
DATABASE_URL=postgresql://reservet_candidate:local_candidate_password@localhost:5432/reservet_candidate

# Base de pruebas de integración (debe terminar en _test; nunca la de trabajo):
# TEST_DATABASE_URL=postgresql://reservet_candidate:local_candidate_password@localhost:5432/reservet_candidate_test
# Solo para `npm run db:seed` (se pasan al ejecutar el comando; no guardes contraseñas reales aquí):
# SEED_USERNAME=demo
# SEED_PASSWORD=cambia-esta-clave-local
